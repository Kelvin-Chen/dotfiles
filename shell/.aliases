# vi:ft=zsh

if [[ -n "${EDITOR:-}" ]] && command -v "$EDITOR" &>/dev/null; then
    alias vi="$EDITOR"
    alias vim="$EDITOR"
fi

# Remote hosts almost never have terminfo for newer terminals (xterm-kitty,
# xterm-ghostty, ...), which breaks vim/less/tmux/htop over ssh with "unknown
# terminal type". Present as xterm-256color instead: every host has it, and
# these terminals are all xterm-compatible. `function` syntax (rather than
# `ssh()`) so a pre-existing `ssh` alias cannot turn this into a parse error.
function ssh {
    case "${TERM:-}" in
        xterm-kitty|xterm-ghostty|alacritty*|wezterm|foot*|rio)
            TERM=xterm-256color command ssh "$@" ;;
        *)
            command ssh "$@" ;;
    esac
}

echo_ip () {
    if command -v dig &>/dev/null; then
        dig TXT +short o-o.myaddr.l.google.com @ns.google.com | sed "s/\"//g"
    elif command -v curl &>/dev/null; then
        curl -fsSL https://api.ipify.org
        echo
    else
        echo "echo_ip requires dig or curl" >&2
        return 127
    fi
}

alias emacs="emacs -nw"

if [[ "$OSTYPE" == darwin* ]]; then
    # macOS ships BSD ls, but Homebrew coreutils may shadow it with GNU ls.
    # Only this case is ambiguous, so it is the only one worth a subprocess.
    if ls --version &>/dev/null; then
        alias ls='ls -ogh --color=auto'  # GNU ls (coreutils)
    else
        alias ls='ls -oghG'              # BSD ls
    fi
elif [[ "$OSTYPE" == linux* ]]; then
    alias ls='ls -ogh --color=auto'      # GNU ls (Linux)
elif ls --color=auto -d . &>/dev/null; then
    alias ls='ls -ogh --color=auto'      # GNU ls elsewhere
else
    alias ls='ls -ogh'                   # BSD/other: stick to POSIX-ish flags
fi

fzfc () {
    if ! command -v fzf &>/dev/null; then
        echo "fzfc requires fzf" >&2
        return 127
    fi

    if command -v rg &>/dev/null; then
        rg --line-number --hidden --glob '!.git' --color=never "${1:-}" | fzf
    else
        grep --line-number --recursive --binary-files=without-match --color=never "${1:-}" . | fzf
    fi
}

alias less='less --tabs=4 -RFX'
